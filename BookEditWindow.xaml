<Window x:Class="Book_Manager_WPF.BookEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Книга" Height="250" Width="300">

    <StackPanel Margin="15">
        <TextBlock Text="Название:"/>
        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10"/>

        <TextBlock Text="Автор:"/>
        <TextBox Text="{Binding Author, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10"/>

        <TextBlock Text="Год:"/>
        <TextBox Text="{Binding Year, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,15"/>

        <Button Content="Сохранить" Click="Save_Click" Height="25"/>
    </StackPanel>
</Window>